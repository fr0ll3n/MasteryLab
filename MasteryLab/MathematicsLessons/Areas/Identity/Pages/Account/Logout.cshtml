@page
@model MathematicsLessons.Areas.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Log out";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<div class="text-center py-5 mx-auto" style="max-width:460px">
