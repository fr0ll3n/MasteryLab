@page
@model MathematicsLessons.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<div class="settings-page mx-auto" style="max-width:680px">
    <div class="mb-4">
        <span class="section-label">Security</span>
        <h1 class="page-title">Change password</h1>
        <p class="page-lead mb-0">Choose a strong password that you do not use elsewhere.</p>
    </div>
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }
    <div class="card">
        <div class="card-body p-4 p-md-5">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Input.OldPassword">Current password</label>
                    <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Input.NewPassword">New password</label>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label class="form-label" asp-for="Input.ConfirmPassword">Confirm new password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
                <div class="d-flex justify-content-between gap-2 flex-wrap">
                    <a asp-page="./Index" class="btn btn-outline-secondary">Back to settings</a>
                    <button type="submit" class="btn btn-primary">Update password</button>
                </div>
            </form>
        </div>
    </div>
</div>
