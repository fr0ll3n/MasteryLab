@page
@model MathematicsLessons.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Profile settings";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<div class="settings-page mx-auto" style="max-width:780px">
    <div class="mb-4">
        <span class="section-label">Your account</span>
        <h1 class="page-title">Profile settings</h1>
        <p class="page-lead mb-0">Keep your contact details up to date.</p>
    </div>
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }
    <div class="card">
        <div class="card-body p-4 p-md-5">
            <div class="mb-4">
                <div class="small text-muted mb-1">Signed-in email</div>
                <div class="fw-semibold">@Model.Email</div>
            </div>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Input.FirstName">First name</label>
                        <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Input.LastName">Last name</label>
                        <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Input.PhoneNumber">Phone number</label>
                        <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
                    <a asp-page="./ChangePassword" class="btn btn-outline-secondary">Change password</a>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
