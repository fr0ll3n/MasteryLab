@page
@{
    ViewData["Title"] = "Access denied";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<div class="text-center mx-auto py-5" style="max-width:560px">
    <div class="display-4 fw-bold mb-2" style="color:var(--br-primary)"><i class="bi bi-shield-lock"></i></div>
    <span class="section-label">Restricted area</span>
    <h1 class="page-title">You don't have access to this page</h1>
    <p class="page-lead mx-auto">Your account does not have the permissions needed to view this section.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return to home</a>
</div>
