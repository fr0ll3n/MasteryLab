@model List<MathematicsLessons.Infrastructure.Data.Entities.Sub>
@{
  ViewData["Title"] = "Subscription";
  var isSubscriber = ViewBag.IsSubscriber as bool? ?? false;
  var loggedIn = ViewBag.IsLoggedIn as bool? ?? false;
}
<h1 class="page-title">Subscription plans</h1>
<p class="page-lead">Free includes the first Beginner lesson. Math Enthusiast unlocks everything.</p>
@if (Model == null || !Model.Any())
{
  <div class="alert alert-warning">No plans yet. Admin should run Update-Database (CatalogSeed).</div>
}
else
{
  <div class="row g-4">
  @foreach (var plan in Model.OrderBy(p => p.PricePerMonth))
  {
    var isFree = plan.PricePerMonth <= 0;
    <div class="col-md-6">
      <div class="card h-100 @(isFree ? "" : "plan-featured")">
        <div class="card-body d-flex flex-column p-4">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h2 class="h5 mb-0">@plan.Type</h2>
            <span class="badge-soft">@(isFree ? "Free" : "Popular")</span>
          </div>
          <p class="text-muted small">@plan.Description</p>
          <div class="mb-3">
            @if (isFree)
            { <div class="h3 mb-0">0.00 <small class="text-muted">BGN</small></div> }
            else
            {
              <div class="h3 mb-0">@plan.PricePerMonth.ToString("0.00") <small class="text-muted">BGN/mo</small></div>
              <div class="small text-muted">or @plan.PricePerYear.ToString("0.00") BGN/year</div>
            }
          </div>
          <ul class="small text-muted mb-4">
            @if (isFree) { <li>First Beginner lesson</li><li>Progress tracking</li> }
            else {
              <li>All courses</li><li>Private lessons</li>
              @if (plan.IncludesPrivateSessions) { <li>Up to @plan.MaxSessionsPerMonth sessions/month</li> }
            }
          </ul>
          <div class="mt-auto">
          @if (!loggedIn)
          { <a class="btn btn-primary w-100" asp-area="Identity" asp-page="/Account/Register">Register</a> }
          else if (isSubscriber && !isFree)
          { <button class="btn btn-outline-secondary w-100" disabled>Current plan</button> }
          else if (isFree)
          { <a class="btn btn-outline-secondary w-100" asp-controller="Classroom" asp-action="Index">Go to courses</a> }
          else
          { <a class="btn btn-primary w-100" asp-action="Checkout" asp-route-planId="@plan.Id">Subscribe</a> }
          </div>
        </div>
      </div>
    </div>
  }
  </div>
}
