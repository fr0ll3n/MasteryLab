@model List<MathematicsLessons.Infrastructure.Data.Entities.Sub>
@{
  ViewData["Title"] = "Premium";
  var isSubscriber = ViewBag.IsSubscriber as bool? ?? false;
  var loggedIn = ViewBag.IsLoggedIn as bool? ?? false;
}
<div class="text-center mb-4">
  <div class="pz-pill" style="color:var(--br-primary)">Premium</div>
  <h1 class="page-title">Level up with Premium</h1>
  <p class="page-lead mx-auto">Unlimited courses, private lessons, and full progress tracking.</p>
</div>
@if (Model == null || !Model.Any())
{
  <div class="alert alert-warning">No plans yet. Run Update-Database (CatalogSeed).</div>
}
else
{
  <div class="row g-4 justify-content-center">
  @foreach (var plan in Model.OrderBy(p => p.PricePerMonth))
  {
    var isFree = plan.PricePerMonth <= 0;
    <div class="col-md-5">
      <div class="card h-100 @(isFree ? "" : "plan-featured")">
        <div class="card-body d-flex flex-column p-4">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h2 class="h5 mb-0">@plan.Type</h2>
            <span class="badge-soft">@(isFree ? "Free" : "Popular")</span>
          </div>
          <p class="text-muted small">@plan.Description</p>
          <div class="mb-3">
            @if (isFree)
            { <div class="h2 mb-0 fw-bold">0 <small class="text-muted fs-6">BGN</small></div> }
            else
            {
              <div class="h2 mb-0 fw-bold">@plan.PricePerMonth.ToString("0.00") <small class="text-muted fs-6">BGN/mo</small></div>
              <div class="small text-muted">or @plan.PricePerYear.ToString("0.00") BGN/year</div>
            }
          </div>
          <ul class="small text-muted mb-4">
            @if (isFree)
            { <li>First Beginner lesson</li><li>Progress tracking</li> }
            else
            {
              <li>Unlimited learning</li>
              <li>All courses unlocked</li>
              <li>Private lessons</li>
              @if (plan.IncludesPrivateSessions) { <li>Up to @plan.MaxSessionsPerMonth sessions/month</li> }
            }
          </ul>
          <div class="mt-auto">
          @if (!loggedIn)
          { <a class="btn btn-primary w-100" asp-area="Identity" asp-page="/Account/Register">Get started</a> }
          else if (isSubscriber && !isFree)
          { <button class="btn btn-outline-secondary w-100" disabled>Current plan</button> }
          else if (isFree)
          { <a class="btn btn-outline-secondary w-100" asp-controller="Classroom" asp-action="Index">Go to courses</a> }
          else
          { <a class="btn btn-primary w-100" asp-action="Checkout" asp-route-planId="@plan.Id">Unlock Premium</a> }
          </div>
        </div>
      </div>
    </div>
  }
  </div>
}
