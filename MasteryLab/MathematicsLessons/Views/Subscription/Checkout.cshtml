@{
  ViewData["Title"] = "Checkout";
  var plan = ViewBag.Plan as MathematicsLessons.Infrastructure.Data.Entities.Sub;
}
<div class="auth-wrap">
  <div class="card">
    <div class="card-body p-4">
      <h1 class="page-title h4">Checkout</h1>
      @if (plan == null)
      { <p class="text-muted">Plan not found.</p> }
      else
      {
        <p class="text-muted">@plan.Type</p>
        <p class="h4">@plan.PricePerMonth.ToString("0.00") BGN / month</p>
        <p class="small text-muted">or @plan.PricePerYear.ToString("0.00") BGN / year</p>
        <form method="post" asp-action="Confirm">
          @Html.AntiForgeryToken()
          <input type="hidden" name="planId" value="@plan.Id" />
          <div class="mb-3">
            <label class="form-label">Billing</label>
            <select name="annual" class="form-select">
              <option value="false">Monthly — @plan.PricePerMonth.ToString("0.00") BGN</option>
              <option value="true">Annual — @plan.PricePerYear.ToString("0.00") BGN</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary w-100">Confirm subscription</button>
        </form>
      }
      <a class="btn btn-link btn-sm mt-2" asp-action="Plans">Back to plans</a>
    </div>
  </div>
</div>
