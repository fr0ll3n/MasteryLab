@model MathematicsLessons.Models.ClassroomPage
@{ ViewData["Title"] = "Courses"; }
<div class="d-flex flex-wrap justify-content-between align-items-start mb-4 gap-3">
  <div>
    <h1 class="page-title">Courses</h1>
    <p class="page-lead mb-0">
      @if (Model.IsSubscribed)
      { <span class="badge-soft green">Math Enthusiast</span> <span class="small text-muted ms-1">Full access</span> }
      else
      { <span class="badge-soft">Free</span> <span class="small text-muted ms-1">First Beginner lesson —
        <a asp-controller="Subscription" asp-action="Plans">see prices</a></span> }
    </p>
  </div>
  <a class="btn btn-outline-secondary btn-sm" asp-controller="Subscription" asp-action="Plans">Subscription</a>
</div>

<form method="get" class="mb-4" asp-action="Index">
  <div class="input-group" style="max-width:480px">
    <input type="search" name="q" value="@Model.SearchQuery" class="form-control" placeholder="Search lessons, sections…" />
    <button type="submit" class="btn btn-primary">Search</button>
  </div>
</form>
@if (!string.IsNullOrEmpty(Model.SearchQuery))
{
  <div class="card mb-4">
    <div class="card-body">
      <h2 class="h6 mb-3">Results for “@Model.SearchQuery” (@Model.SearchHits.Count)</h2>
      @if (!Model.SearchHits.Any())
      { <p class="text-muted mb-0">No lessons matched.</p> }
      else
      {
        <div class="list-group list-group-flush">
        @foreach (var hit in Model.SearchHits.Take(40))
        {
          <div class="list-group-item bg-transparent px-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
              <div class="fw-semibold">@hit.LessonTitle</div>
              <div class="small text-muted">@hit.LevelName · @hit.TopicName</div>
            </div>
            <div>
              @if (hit.IsCompleted) { <span class="badge-soft green me-1">Done</span> }
              @if (hit.IsUnlocked)
              { <a class="btn btn-sm btn-primary" asp-action="Lesson" asp-route-id="@hit.LessonId">Open</a> }
              else
              { <span class="btn btn-sm btn-outline-secondary disabled">Locked</span> }
            </div>
          </div>
        }
        </div>
      }
    </div>
  </div>
}


@if (Model.Levels == null || !Model.Levels.Any())
{
  <div class="alert alert-warning">No courses in the database. Admin: run Update-Database (CatalogSeed).</div>
}
else
{
  <div class="row g-3">
  @foreach (var block in Model.Levels)
  {
    var locked = !block.IsUnlocked;
    var img = block.Level.SortOrder switch
    {
      1 => "https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=600&q=80",
      2 => "https://images.unsplash.com/photo-1509228468518-180dd4864904?w=600&q=80",
      3 => "https://images.unsplash.com/photo-1635070041078-e363dbe005cb?w=600&q=80",
      _ => "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=600&q=80"
    };
    <div class="col-md-6 col-lg-3">
      <div class="card course-card card-level h-100">
        <img class="card-img-top" src="@img" alt="@block.Level.Name" />
        <div class="card-body d-flex flex-column">
          <div class="d-flex justify-content-between align-items-center">
            <span class="badge-soft">@block.Level.Name</span>
            @if (locked) { <span class="small text-muted"><i class="bi bi-lock"></i></span> }
          </div>
          <div class="small text-muted mt-1">@block.Level.GradeRange</div>
          <p class="small mt-2 mb-3">@block.Level.Description</p>
          <div class="progress mb-2"><div class="progress-bar" style="width:@block.Percent%"></div></div>
          <div class="small text-muted mb-3">@block.Completed / @block.Total lessons</div>
          @if (locked)
          {
            <a class="btn btn-sm btn-primary mt-auto" asp-controller="Subscription" asp-action="Plans">Unlock</a>
          }
          else
          {
            <a class="btn btn-sm btn-primary mt-auto" asp-action="Level" asp-route-id="@block.Level.Id">Open course</a>
          }
        </div>
      </div>
    </div>
  }
  </div>
}
