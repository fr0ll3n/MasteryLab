@model MathematicsLessons.Models.ProfilePage
@{
    ViewData["Title"] = "Profile";
    var rank = Model.Rank;
    var rankName = rank?.Name ?? "Member";
}
<h1 class="page-title">Profile</h1>
<p class="page-lead">Your progress on MasteryLab</p>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="rounded-circle d-flex align-items-center justify-content-center"
               style="width:56px;height:56px;background:var(--pz-primary-soft);color:var(--pz-primary);font-weight:800">
            @((Model.User.FirstName?.FirstOrDefault() ?? 'U'))
          </div>
          <div>
            <div class="fw-bold">@Model.User.DisplayName</div>
            <div class="small text-muted">@Model.User.Email</div>
          </div>
        </div>
        <div class="mb-2">
          <span class="badge-soft">@rankName</span>
          @if (Model.User.Sub != null)
          { <span class="badge-soft green ms-1">@Model.User.Sub.Type</span> }
          else
          { <span class="badge-soft ms-1">Free</span> }
        </div>
        @if (rank != null && rank.MonthsSubscribed > 0)
        {
          <p class="small text-muted mb-0">Subscriber for @rank.MonthsSubscribed month(s)</p>
        }
        <hr />
        <a class="btn btn-sm btn-outline-secondary" asp-area="Identity" asp-page="/Account/Manage/Index">Account settings</a>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
          <div class="small text-muted">Points</div>
          <div class="h3 mb-0">@Model.User.Points</div>
        </div></div>
      </div>
      <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
          <div class="small text-muted">Completed lessons</div>
          <div class="h3 mb-0">@Model.CompletedLessons</div>
        </div></div>
      </div>
      <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
          <div class="small text-muted">Day streak</div>
          <div class="h3 mb-0">@Model.User.StreakDays</div>
        </div></div>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-body">
        <h2 class="h6 fw-bold mb-3">Certificates</h2>
        @if (Model.Certificates == null || !Model.Certificates.Any())
        {
          <p class="text-muted mb-0 small">Finish every lesson in a level to earn a certificate.</p>
        }
        else
        {
          <ul class="list-unstyled mb-0">
          @foreach (var c in Model.Certificates)
          {
            <li class="d-flex justify-content-between align-items-center border-bottom py-2">
              <span>
                <i class="bi bi-award text-warning"></i>
                @(Model.LevelNames.GetValueOrDefault(c.LevelId, $"Level {c.LevelId}"))
                <span class="small text-muted">· @c.IssuedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
              </span>
              <span class="badge-soft green">Earned</span>
            </li>
          }
          </ul>
        }
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <h2 class="h6 fw-bold mb-2">Loyalty ranks (Math Enthusiast)</h2>
        <p class="small text-muted">Months subscribed unlock badges:</p>
        <div class="d-flex flex-wrap gap-2">
          @foreach (var (name, need) in new[] { ("Bronze","3"), ("Silver","5"), ("Gold","8"), ("Emerald","12"), ("Diamond","15"), ("Master","24") })
          {
            var active = rank != null && rank.MonthsSubscribed >= int.Parse(need);
            <span class="badge-soft @(active ? "green" : "")">@name · @need mo</span>
          }
        </div>
      </div>
    </div>
  </div>
</div>
