@{
    ViewData["Title"] = "Book private lesson";
    var plans = ViewBag.Plans as List<MathematicsLessons.Infrastructure.Data.Entities.AppointmentPlan> ?? new();
    var teachers = ViewBag.Teachers as List<MathematicsLessons.Models.TeacherOption> ?? new();
    var selectedPlanId = ViewBag.SelectedPlanId as int?;
    var selectedTeacherId = ViewBag.SelectedTeacherId as string;
    var selectedDate = ViewBag.SelectedDate as string;
    var selectedPlan = ViewBag.SelectedPlan as MathematicsLessons.Infrastructure.Data.Entities.AppointmentPlan;
    var hours = ViewBag.Hours as List<string> ?? new();
    var minDate = ViewBag.MinDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var maxDate = ViewBag.MaxDate as string ?? DateTime.Today.AddDays(60).ToString("yyyy-MM-dd");
}
<a class="course-back" asp-action="Index">← My sessions</a>
<h1 class="page-title">Book a private lesson</h1>
<p class="page-lead">@ViewBag.TimeZoneNote</p>

@* Step 1: duration *@
<p class="section-label">1 · Duration &amp; price</p>
<div class="row g-3 mb-4">
@foreach (var p in plans)
{
    var active = selectedPlanId == p.Id;
    <div class="col-md-4">
        <a class="card duration-card h-100 text-decoration-none @(active ? "plan-featured" : "")"
           asp-action="Book" asp-route-planId="@p.Id" asp-route-date="@selectedDate" asp-route-teacherId="@selectedTeacherId">
            <div class="card-body p-4">
                <h2 class="h6 mb-1">@p.Name</h2>
                <div class="h4 fw-bold text-primary">@p.Price.ToString("0.00") <small class="fs-6 text-muted">BGN</small></div>
                <p class="small text-muted mb-0">@p.Description</p>
            </div>
        </a>
    </div>
}
</div>

@if (selectedPlan != null)
{
    <form method="get" asp-action="Book" class="card mb-4">
        <div class="card-body p-4">
            <input type="hidden" name="planId" value="@selectedPlan.Id" />
            <p class="section-label">2 · Teacher</p>
            <div class="mb-3">
                <select name="teacherId" class="form-select" required onchange="this.form.submit()">
                    <option value="">Select teacher…</option>
                    @foreach (var t in teachers)
                    {
                        if (t.Id == selectedTeacherId)
                        { <option value="@t.Id" selected>@t.Name</option> }
                        else
                        { <option value="@t.Id">@t.Name</option> }
                    }
                </select>
            </div>
            <p class="section-label">3 · Date</p>
            <div class="mb-3">
                <input type="date" name="date" class="form-control" min="@minDate" max="@maxDate"
                       value="@selectedDate" required onchange="this.form.submit()" />
            </div>
        </div>
    </form>
}

@if (selectedPlan != null && !string.IsNullOrEmpty(selectedTeacherId) && !string.IsNullOrEmpty(selectedDate))
{
    <div class="card mb-4">
        <div class="card-body p-4">
            <p class="section-label">4 · Available hours</p>
            @if (hours.Count == 0)
            {
                <p class="text-muted mb-0">No free slots this day for that teacher (busy 2h blocks or outside 08:00–23:00). Try another day.</p>
            }
            else
            {
                <form method="post" asp-action="Book">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="planId" value="@selectedPlan.Id" />
                    <input type="hidden" name="teacherId" value="@selectedTeacherId" />
                    <input type="hidden" name="date" value="@selectedDate" />
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var h in hours)
                        {
                            <label class="btn btn-outline-primary hour-chip">
                                <input type="radio" name="hour" value="@h" required class="d-none" />
                                @h
                            </label>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Note (optional)</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Topic you want to focus on…"></textarea>
                    </div>
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="text-muted small">@selectedPlan.Name · <strong>@selectedPlan.Price.ToString("0.00") BGN</strong></div>
                        <button type="submit" class="btn btn-primary">Continue to payment</button>
                    </div>
                </form>
            }
        </div>
    </div>
}

<style>
.duration-card { transition: transform .12s; color: inherit; }
.duration-card:hover { transform: translateY(-2px); }
.hour-chip { min-width: 4.5rem; }
.hour-chip:has(input:checked) {
  background: var(--br-primary, #1769a6);
  color: #fff;
  border-color: var(--br-primary, #1769a6);
}
</style>
