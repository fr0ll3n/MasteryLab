@{
  ViewData["Title"] = "Placement result";
  var name = ViewBag.LevelName as string ?? "Beginner";
  var id = ViewBag.LevelId as int? ?? 1;
  var range = ViewBag.GradeRange as string ?? "";
  var score = ViewBag.Score as int? ?? 0;
}
<div class="text-center mb-4">
  <div class="pz-pill" style="color:var(--br-primary)">Recommended path</div>
  <h1 class="page-title">@name</h1>
  <p class="page-lead mx-auto">@range · score @score / 9</p>
</div>
<div class="card mb-3"><div class="card-body text-center p-4">
  <p class="text-muted mb-3">Start here, or browse the full catalog. Free accounts still unlock only the first Beginner lesson until Premium.</p>
  <a class="btn btn-primary me-2" asp-controller="Classroom" asp-action="Level" asp-route-id="@id">Open @name</a>
  <a class="btn btn-outline-secondary" asp-controller="Classroom" asp-action="Index">All courses</a>
  <a class="btn btn-outline-secondary ms-2" asp-action="Index">Retake</a>
</div></div>
