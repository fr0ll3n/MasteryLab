@using MathematicsLessons.Infrastructure.Data
@using MathematicsLessons.Infrastructure.Data.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject ApplicationDbContext Db
@{
    var isSub = false;
    if (SignInManager.IsSignedIn(User))
    {
        var uid = UserManager.GetUserId(User);
        isSub = Db.Users.AsNoTracking().Any(u => u.Id == uid && u.SubId != null);
    }
}
@{
  var routeController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "page").ToLowerInvariant();
  var routeAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? "index").ToLowerInvariant();
  var routePage = (ViewContext.RouteData.Values["page"]?.ToString() ?? "").ToLowerInvariant().Replace("/", "-").Replace(".", "-");
  var pageClass = $"page-{routeController}-{routeAction} {routePage}";
}
@{ var unreadNotif = 0;
  if (SignInManager.IsSignedIn(User)) {
    var uid2 = UserManager.GetUserId(User);
    unreadNotif = Db.Notifications.AsNoTracking().Count(n => n.UserId == uid2 && !n.IsRead);
  }
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · MasteryLab</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.IsInRole("Admin"))
{
    <div class="admin-bar">
        <div class="container">
            <span class="admin-bar-label">Admin</span>
            <a asp-controller="Admin" asp-action="Index">Panel</a>
            <a asp-controller="Admin" asp-action="Users">Users</a>
            <a asp-controller="Admin" asp-action="Plans">Prices</a>
            <a asp-controller="Admin" asp-action="SessionPlans">Sessions</a>
            <a asp-controller="CourseAdmin" asp-action="Index">Courses</a>
            <a asp-controller="Admin" asp-action="Bookings">Bookings</a>
        </div>
    </div>
}
<header class="site-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="MasteryLab" class="brand-logo" width="40" height="40" />
                <span>Mastery<span>Lab</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Classroom" asp-action="Index">Courses</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Placement" asp-action="Index">Placement</a></li>
                        @if (isSub)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Index">Private lesson</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" asp-controller="Sessions" asp-action="Index">Discord</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Subscription" asp-action="Plans">Premium</a></li>
                        <li class="nav-item">
                          <a class="nav-link" asp-controller="Notifications" asp-action="Index">
                            Alerts@(unreadNotif > 0 ? $" ({unreadNotif})" : "")
                          </a>
                        </li>
                        @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Teacher" asp-action="Dashboard">Teacher</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="CourseAdmin" asp-action="Index">Manage</a></li>
                        }
                    </ul>
                }
                else
                {
                    <ul class="navbar-nav me-auto"></ul>
                }
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="themeToggle" aria-label="Toggle color theme">Dark</button>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </nav>
</header>
<main class="site-main page-view @pageClass">
    <div class="container py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning border-0">@TempData["Error"]</div>
        }
        @RenderBody()
    </div>
</main>
<footer class="site-footer">
    <div class="container">
      <div class="row g-3">
        <div class="col-md-5">
          <div class="fw-bold mb-1" style="font-family:Georgia,serif">Mastery<span style="color:var(--green,#2f6f4e)">Lab</span></div>
          <p class="mb-0 small">Сайт за математика: видеа, упражнения и частни уроци. Направлен като учебен проект.</p>
        </div>
        <div class="col-6 col-md-2">
          <div class="small fw-bold mb-1">Навигация</div>
          <a class="d-block small mb-1" asp-controller="Classroom" asp-action="Index">Курсове</a>
          <a class="d-block small mb-1" asp-controller="Subscription" asp-action="Plans">Цени</a>
          <a class="d-block small mb-1" asp-controller="Placement" asp-action="Index">Placement</a>
        </div>
        <div class="col-6 col-md-2">
          <div class="small fw-bold mb-1">Инфо</div>
          <a class="d-block small mb-1" asp-controller="Home" asp-action="About">За сайта</a>
          <a class="d-block small mb-1" asp-controller="Home" asp-action="Privacy">Поверителност</a>
        </div>
        <div class="col-md-3">
          <div class="small fw-bold mb-1">Въпрос?</div>
          <p class="small mb-0">Започни с безплатен акаунт и три урока. После избери месечен или годишен план.</p>
        </div>
      </div>
      <div class="mt-3 pt-2 small" style="border-top:1px solid var(--line,#e4ddd2)">
        &copy; @DateTime.UtcNow.Year MasteryLab
      </div>
    </div>
  </footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
