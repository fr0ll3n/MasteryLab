@model List<MathematicsLessons.Models.TeacherStudentRow>
@{ ViewData["Title"] = "Students"; var q = ViewBag.Search as string; }
<a class="course-back" asp-action="Dashboard">← Dashboard</a>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h1 class="page-title mb-0">Student progress</h1>
  <form method="get" class="d-flex gap-2">
    <input class="form-control form-control-sm" name="q" value="@q" placeholder="Name or email" style="min-width:200px" />
    <button class="btn btn-sm btn-primary" type="submit">Search</button>
  </form>
</div>
@if (!Model.Any())
{ <p class="text-muted">No students found.</p> }
else
{
  <div class="table-responsive card">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr class="small text-muted">
          <th>Student</th>
          <th>Plan</th>
          <th>Completed</th>
          <th>Points</th>
          <th>Streak</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      @foreach (var s in Model)
      {
        <tr>
          <td>
            <div class="fw-semibold">@s.DisplayName</div>
            <div class="small text-muted">@s.Email</div>
          </td>
          <td><span class="badge-soft">@s.Plan</span></td>
          <td>@s.CompletedLessons / @s.TotalLessons</td>
          <td>@s.Points</td>
          <td>@s.StreakDays</td>
          <td><a class="btn btn-sm btn-outline-secondary" asp-action="Student" asp-route-id="@s.UserId">Details</a></td>
        </tr>
      }
      </tbody>
    </table>
  </div>
}
